# ========================================
# REQUIRED CONFIGURATION
# ========================================

# Your Immich server URL (no trailing slash)
# Examples:
#   - Local: http://localhost:2283
#   - Network: http://192.168.1.100:2283
#   - Docker: http://immich-server:2283
IMMICH_URL=http://localhost:2283

# Your Immich API key
# Get this from Immich: User Settings → Account Settings → API Keys
IMMICH_API_KEY=your-immich-api-key-here


# ========================================
# OPTIONAL SERVER CONFIGURATION
# ========================================

# Port the server will run on (default: 3000)
PORT=3000

# Public base URL for absolute media links (optional)
# Set when clients cannot derive the host from requests (e.g. native mobile apps)
# Example: https://slides.example.com
# PUBLIC_BASE_URL=

# Public-facing URL of your Immich instance (optional)
# Used for Photo.inAppUrl deep-links (the "open in Immich" button).
# Defaults to IMMICH_URL. Set this only when Immich is reachable at a different
# external address (e.g. IMMICH_URL is an internal IP but Immich is also behind
# a reverse proxy at https://immich.example.com).
# IMMICH_PUBLIC_URL=

# CORS Access-Control-Allow-Origin (optional, default: *)
# Set to your kiosk origin in production, e.g. https://slides.example.com
# CORS_ALLOWED_ORIGIN=


# ========================================
# OPTIONAL FRONTEND DEFAULTS
# ========================================
# These set initial values when users first load the app
# Users can change these settings in the UI
# UI overrides are persisted via /api/v1/settings (in-memory on the server; resets on restart)

# Layout: single or split
DEFAULT_LAYOUT=single

# Slideshow interval in milliseconds
DEFAULT_INTERVAL_MS=30000

# Shuffle photos: true or false
DEFAULT_SHUFFLE=true

# Auto-start slideshow: true or false
DEFAULT_AUTOPLAY=true

# Photo scale mode: fit_inside, fill_crop, stretch, or original
DEFAULT_PHOTO_SCALE_MODE=fit_inside

# Photo animation type: none, zoom-in, zoom-out, pan, or ken-burns
DEFAULT_PHOTO_ANIMATION_TYPE=zoom-in

# Photo animation duration in milliseconds (should match or be close to interval)
DEFAULT_PHOTO_ANIMATION_DURATION=30000

# Photo animation intensity: 1.0 (subtle) to 2.0 (dramatic)
DEFAULT_PHOTO_ANIMATION_INTENSITY=1.2

# Hour format: 12 or 24
DEFAULT_HOUR_FORMAT=12

# Transition type: fade, slide, or none
DEFAULT_TRANSITION_TYPE=fade

# Transition duration in milliseconds
DEFAULT_TRANSITION_DURATION=1000

# Show live photos: true or false
DEFAULT_SHOW_LIVE_PHOTO=false

# Delay before switching to live photo video in milliseconds
DEFAULT_LIVE_PHOTO_DELAY=1000


# ========================================
# OPTIONAL PHOTO FILTERS
# ========================================

# Filter by album IDs (comma-separated, no spaces)
# Example: DEFAULT_ALBUM_IDS=abc123,def456,ghi789
# Leave empty to show all albums
DEFAULT_ALBUM_IDS=

# Filter by person IDs (comma-separated, no spaces)
# Example: DEFAULT_PERSON_IDS=person1,person2
# Leave empty to show all people
DEFAULT_PERSON_IDS=

# Filter by location
# Leave empty to show all locations
DEFAULT_LOCATION_COUNTRY=
DEFAULT_LOCATION_STATE=
DEFAULT_LOCATION_CITY=

# Date filtering (ISO format: YYYY-MM-DD)
DEFAULT_START_DATE=
DEFAULT_END_DATE=

# ========================================
# FILTER OPERATORS & EXCLUSIONS
# ========================================

# How to combine multiple album filters
# Options: AND (must match all) or OR (match any)
DEFAULT_ALBUM_OPERATOR=AND

# How to combine multiple person filters
# Options: AND (must match all) or OR (match any)
DEFAULT_PERSON_OPERATOR=AND

# Album IDs to exclude (comma-separated, no spaces)
# Example: DEFAULT_EXCLUDE_ALBUM_IDS=abc123,def456
DEFAULT_EXCLUDE_ALBUM_IDS=

# Person IDs to exclude (comma-separated, no spaces)
# Example: DEFAULT_EXCLUDE_PERSON_IDS=person1,person2
DEFAULT_EXCLUDE_PERSON_IDS=

# How to combine different filter types (albums, people, location, etc.)
# Options: AND (must satisfy all filters) or OR (satisfy any filter)
DEFAULT_GLOBAL_OPERATOR=AND


# ========================================
# OPTIONAL WEATHER INTEGRATION
# ========================================

# OpenWeatherMap API key (required for weather feature)
# Get free API key at: https://openweathermap.org/api
OWM_KEY=

# Default weather location coordinates
# Example: San Francisco
#   DEFAULT_WEATHER_LAT=37.7749
#   DEFAULT_WEATHER_LNG=-122.4194
DEFAULT_WEATHER_LAT=
DEFAULT_WEATHER_LNG=
