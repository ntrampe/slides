{
  "name": "slides",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:ui": "npm run dev -w @slides/web",
    "dev:server": "npm run dev -w @slides/server",
    "dev": "npm run dev:server & npm run dev:ui",
    "build": "npm run contract:gen && npm run build -w @slides/web",
    "build:server": "npm run build -w @slides/server",
    "build:demo": "npm run build:demo -w @slides/web",
    "lint": "eslint .",
    "preview": "npm run preview -w @slides/web",
    "contract:gen": "npm run gen -w @slides/api-contract"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
